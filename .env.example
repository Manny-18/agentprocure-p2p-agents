# Copy to .env. With LLM_PROVIDER=offline (default) everything runs with no key and no internet:
# the rules engine computes every number and expert templates write the explanations.
LLM_PROVIDER=offline

# --- Free option: Google Gemini (get a key at https://aistudio.google.com) ---
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=your-key
# LLM_MODEL=gemini-flash-latest      # alias for the current Flash model
# LLM_MODEL=gemini-flash-lite-latest # larger free daily quota; use this if you hit "GenerateRequestsPerDay"

# --- Other providers ---
# LLM_PROVIDER=openai      OPENAI_API_KEY=...     LLM_MODEL=gpt-5-mini
# LLM_PROVIDER=anthropic   ANTHROPIC_API_KEY=...  LLM_MODEL=claude-haiku-5-5
# LLM_PROVIDER=ollama      LLM_MODEL=llama3.1   (local, free; run `ollama serve`)

LLM_TEMPERATURE=0.2
USE_CREWAI=true
